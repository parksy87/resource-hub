# PHP REST API 배포 경로로 교체합니다. 끝의 슬래시는 생략합니다.
VITE_API_BASE_URL=/api

# Firebase Web App 설정 (Firebase Console > 프로젝트 설정 > 일반 > 내 앱)
# 값은 .env에만 입력하고 Git에 올리지 않습니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 관리자 로그인 화면 ID(admin)와 연결할 Firebase Authentication 이메일 (비밀번호는 Console에서 관리)
VITE_ADMIN_AUTH_EMAIL=
